->Program using list functions:
import java.util.LinkedList;
class Main{
    public static void main(String[] args) {
        LinkedList <Integer> list=new LinkedList< >();
        list.add(10);
        list.add(20);
        list.add(30);
        list.addFirst(5);
        list.addLast(32);
        list.removeFirst();
        list.removeLast();
        System.out.println(list.getFirst());
        System.out.println(list.getLast());
        System.out.println("List:"+list);
    }
}
output:
10
30
List:[10, 20, 30]

->Programming using Collection:
import java.util.Collections;
import java.util.LinkedList;
class Main{
    public static void main(String[] args) {
        LinkedList <Integer> list=new LinkedList< >();
        list.add(10);
        list.add(20);
        list.add(30);
        list.add(25);
        list.addFirst(5);
        list.addLast(32);
        list.removeFirst();
        list.removeLast();
        Collections.sort(list);
         Collections.sort(list,Collections.reverseOrder());
        System.out.println(list.getFirst());
        System.out.println(list.getLast());
        System.out.println("List:"+list);
    }
}
output:
30
10
List:[30, 25, 20, 10]

->Programming using HashSet:
import java.util.HashSet;
class Main{
    public static void main(String[] args) {
        HashSet<Integer> ai=new HashSet< >();
        ai.add(10);
        ai.add(20);
        ai.add(10);
        ai.add(40);
        System.out.println("Contain amulya:"+ai.contains("amulya"));
        System.out.println("Contain 20:"+ai.contains(20));
        System.out.println("ai:"+ai);
        System.out.println("size:"+ai.size());
    }
}
output:
Contain amulya:false
Contain 20:true
ai:[20, 40, 10]
size:3

